# Local development template. Copy to .env and replace the sample password.
# Docker Compose reads .env; the CLI does not. Export connection variables
# before running python -m src.cli (or use: set -a; . ./.env; set +a).

# Host-side Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-this-local-password # SAMPLE ONLY; choose at least 8 characters
NEO4J_DATABASE=neo4j
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes

# Host-side Kafka connection
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Set to the broker machine's reachable IP or DNS name for remote clients.
KAFKA_EXTERNAL_HOST=localhost
# Consumer group IDs and loading mode belong in the YAML schema:
# loading.consumer_group_id and the CLI's --mode flag.

# Container-side connections on the graph-loader-net Compose network.
# Replace these too when connecting loader containers to remote services.
LOADER_NEO4J_URI=bolt://neo4j:7687
LOADER_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Local bind-mounted state; use an absolute path for a remote Docker daemon.
GRAPH_LOADER_DATA_DIR=./var/data

# Small-machine defaults. Empty CPU sets let Docker choose available CPUs.
# Increase memory / pin disjoint CPU sets for benchmarks (see docs/USAGE.md).
NEO4J_CPUSET=
KAFKA_CPUSET=
LOADER_CPUSET=
NEO4J_HEAP_SIZE=1G
NEO4J_PAGECACHE_SIZE=1G
KAFKA_MEM_LIMIT=2g
KAFKA_HEAP_OPTS='-Xms512m -Xmx1g'

# Optional image overrides when using --skip-image-build:
# GRAPH_LOADER_NODE_IMAGE=graph-loader-node:latest
# GRAPH_LOADER_EDGE_IMAGE=graph-loader-edge:latest
# GRAPH_LOADER_CLOCK_IMAGE=graph-loader-clock:latest
