# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme          # REQUIRED: min 8 characters for Neo4j Enterprise
NEO4J_DATABASE=neo4j
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes

# Kafka connection
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_PREFIX=graph-loader

# Docker node-loader containers use the Compose-network defaults
# (bolt://neo4j:7687 and kafka:29092). Override only for a custom container
# network; host-side CLI monitoring continues to use the values above.
# LOADER_NEO4J_URI=bolt://neo4j:7687
# LOADER_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Loading settings
LOADER_LOG_LEVEL=INFO
