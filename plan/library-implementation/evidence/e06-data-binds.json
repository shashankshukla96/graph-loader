      "sha256:d8b76aedcc897aebd17dcd4dd2cfecb1e2570a7f625b8d0480f7122100bbc610",
      "-I",
      "-c",
      "import errno,hashlib,importlib.resources as r,json,pathlib\nfrom neo4j_graph_loader.schema import load_schema\nload_schema('/app/runtime_schema.yaml')\nfor name,digest in {'graph_schema.yaml': '954ba4fc994cc1d16844a3cc29a1971a94042817c20f4a0a52f70e4ac932b747', 'social_schema.yaml': 'fd558b4bb65671b9cda6514280d23e37a93adebd04e240d938c36173d3f98c74'}.items():\n    assert hashlib.sha256(r.files('neo4j_graph_loader').joinpath('data',name).read_bytes()).hexdigest()==digest,name\nfor name in ('runtime_schema.yaml','edge-plan.json'):\n    try: pathlib.Path('/app',name).write_text('forbidden')\n    except OSError as e: assert e.errno==errno.EROFS,e\n    else: raise AssertionError('readonly bind was writable')\nfor name in ('rejections','write-timings'):\n    pathlib.Path('/app',name,'owned.txt').write_text('written')\nassert pathlib.Path('/app/edge-plan.json').read_text()=='{}'\nprint(json.dumps({'readonly_inputs':True,'writable_outputs':True,'resource_bytes':'equal'}))\n"
    ],
